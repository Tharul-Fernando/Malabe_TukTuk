                           </HBox.margin>
                        </Button>
                     </children>
                  </HBox>
                  <TableView fx:id="dealerTable" minHeight="-Infinity" minWidth="-Infinity" prefHeight="487.0" prefWidth="880.0">
                    <columns>
                      <TableColumn fx:id="colDealerCode" prefWidth="116.6666898727417" text="Dealer Code" />
                      <TableColumn fx:id="colDealerName" prefWidth="142.6666717529297" text="Dealer Name" />
